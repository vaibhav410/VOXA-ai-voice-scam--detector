# Copy to .env.local and fill in. Never commit .env.local or paste keys into client code.
# Lowercase names such as reality_defender_api also work.

# --- Deepfake / authenticity detection ---
REALITY_DEFENDER_API_KEY=      # voice + image (free plan: 50 scans a month, no video)
SEALEDROSE_API_KEY=            # video, or voice/image when AUTH_PROVIDER=sealedrose
AUTH_PROVIDER=auto             # auto | realitydefender | sealedrose

# --- Speech to text / text extraction / intelligence ---
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Optional face liveness for portrait photos ---
LUXAND_API_KEY=

# --- Free-first policy (see API_USAGE.md) ---
# FREE_MODE=1 (default) blocks every provider you have not confirmed as card-free.
FREE_MODE=1
# Providers whose accounts you verified have NO payment method and NO auto top-up:
FREE_MODE_CONFIRMED=

# --- Chrome extension (see the Chrome extension page in the app) ---
# After loading extension/ in chrome://extensions, paste its ID here. Only this ID may call the analyze API.
VOXA_EXTENSION_ID=

# --- Optional ---
# FFMPEG_PATH=C:\path\to\ffmpeg.exe   # defaults to the bundled ffmpeg-static
# PORT=5174

# --- Protected call (#/call) ---
# WebRTC ICE servers as JSON. Default: Google's public STUN only. Add a TURN server for callers behind strict NAT/firewalls:
# VOXA_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# Concurrent live-transcription streams (each protected call or live monitor uses one Deepgram stream). Default 4.
# VOXA_MAX_LIVE_SESSIONS=4
